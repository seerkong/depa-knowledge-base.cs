<?xml version="1.0" encoding="UTF-8"?>
<BusinessObject fqn="ontology.maker-space.business-object.member" id="MakerSpace.Member" parentRef="MakerSpace.Resource">
  <Description>Member business-object resource.</Description>
  <Purpose>Represents a workshop member as a domain object.</Purpose>
  <Identity>
    <Field name="memberNumber" typeRef="MakerSpace.Type.MemberNumber" required="true" />
  </Identity>
  <Fields>
    <Field name="displayName" typeRef="builtin:String" required="true" role="display-name" />
    <Field name="certificationState" typeRef="MakerSpace.Type.CertificationState" required="true" role="classification" />
  </Fields>
  <Evidences>
    <Evidence ref="manual:makerspace-policy" />
  </Evidences>
</BusinessObject>
