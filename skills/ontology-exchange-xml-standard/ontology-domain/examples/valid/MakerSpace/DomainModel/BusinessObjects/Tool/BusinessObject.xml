<?xml version="1.0" encoding="UTF-8"?>
<BusinessObject fqn="ontology.maker-space.business-object.tool" id="MakerSpace.Tool" parentRef="MakerSpace.Resource">
  <Description>Tool business-object resource.</Description>
  <Purpose>Represents a reservable physical workshop tool.</Purpose>
  <Identity>
    <Property name="toolCode" typeRef="MakerSpace.Type.ToolCode" required="true" />
  </Identity>
  <Properties>
    <Property name="displayName" typeRef="builtin:String" required="true" role="display-name" />
    <Property name="toolState" typeRef="MakerSpace.Type.ToolState" required="true" role="state" />
  </Properties>
  <Evidences>
    <Evidence ref="manual:makerspace-policy" />
  </Evidences>
</BusinessObject>
