<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Depa.KnowledgeBase.Wiki.VectorSearch</PackageId>
    <AssemblyName>Depa.KnowledgeBase.Wiki.VectorSearch</AssemblyName>
    <RootNamespace>Depa.KnowledgeBase.Wiki.VectorSearch</RootNamespace>
    <Description>Embedding and vector-search services for Depa KnowledgeBase Wiki.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Depa.KnowledgeBase.Wiki.Core/Depa.KnowledgeBase.Wiki.Core.csproj" />
    <PackageReference Include="Depa.Cozo" Version="0.1.0" />
    <ProjectReference Include="../../../depa-ontology.cs/src/Depa.Ontology/Depa.Ontology.csproj" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Depa.KnowledgeBase.Wiki.Indexing" />
    <InternalsVisibleTo Include="Depa.KnowledgeBase.Wiki.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Models/all-MiniLM-L6-v2/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackagePath>contentFiles/any/any/Models/all-MiniLM-L6-v2/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <Pack>true</Pack>
    </Content>
  </ItemGroup>
</Project>
